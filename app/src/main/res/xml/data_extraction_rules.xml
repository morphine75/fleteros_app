<?xml version="1.0" encoding="utf-8"?>
<!--
    Colocar en: app/src/main/res/xml/data_extraction_rules.xml
    (probablemente ya existe con contenido vacio/default, reemplazarlo)

    Evita que Android incluya la sesion cifrada (auth_prefs) en la copia
    de seguridad de Google o en la transferencia entre celulares. Esa
    sesion esta cifrada con una clave del Keystore del hardware, que
    NUNCA se copia - si se restaura sin esta exclusion, la app no puede
    descifrar los datos viejos y se cierra sola al abrir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>